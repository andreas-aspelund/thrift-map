# Copy this file to .env and fill in your Supabase connection string.
# Use the connection pooler string (port 6543), not the direct connection.
# Remember: if your password contains a space, encode it as %20 in the URL.
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR%20PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
